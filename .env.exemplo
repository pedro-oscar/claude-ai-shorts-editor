# Configurações opcionais. O instalador copia este arquivo para .env.
# Nada aqui é necessário se você já fez login rodando `claude` uma vez.

# Token de longa duração da sua assinatura Claude (Pro/Max), para máquinas sem navegador.
# Gere com:  claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

# Ou uma chave de API do console da Anthropic (cobrança por uso, separada da assinatura).
# ANTHROPIC_API_KEY=
